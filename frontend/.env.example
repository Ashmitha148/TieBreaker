# ==============================================================================
# TieBreaker Frontend Environment Variables (Vercel / Production & Local)
# ==============================================================================
# Railway backend HTTPS URL (e.g. https://tiebreaker-production.up.railway.app)
# Leave empty for local development to use the Vite dev proxy (/api)
VITE_API_URL=""
# Must match backend TIEBREAKER_API_KEY. Also set this in Vercel.
VITE_API_KEY="tiebreaker-local-dev-key"