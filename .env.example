# ==============================================================================
# TieBreaker Backend Environment Variables (Railway / Production & Local)
# ==============================================================================
PROJECT_NAME="TieBreaker"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration:
# - Local fallback: sqlite:///./tiebreaker.db
# - Railway PostgreSQL: postgresql://postgres:<password>@<host>:<port>/railway
# (Note: DATABASE_URL is automatically populated when Railway PostgreSQL plugin is linked)
DATABASE_URL="sqlite:///./tiebreaker.db"

# Razorpay Test Mode Credentials (Keep secrets server-side only)
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Protects POST /api/transactions, POST /api/what-if, and /api/learning/*
# Required in production. Leave empty only for local pytest/dev.
TIEBREAKER_API_KEY="tiebreaker-local-dev-key"

REDIS_URL="redis://localhost:6379/0"

# CORS Configuration: Exact deployed frontend URL plus localhost
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]