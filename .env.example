PROJECT_NAME="TieBreaker"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL ready, SQLite local fallback)
# For local SQLite: sqlite:///./tiebreaker.db
# For PostgreSQL: postgresql://user:password@localhost:5432/tiebreaker_db
DATABASE_URL="sqlite:///./tiebreaker.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
