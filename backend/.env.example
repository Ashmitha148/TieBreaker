PROJECT_NAME="TieBreaker"
ENVIRONMENT="production"
DEBUG=false

DATABASE_URL="sqlite:///./tiebreaker.db"

# ⚠️  Use Razorpay TEST MODE keys only (prefix: rzp_test_). NEVER paste live keys here.
#     Get them from https://dashboard.razorpay.com/keys after enabling "Test Mode".
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_YOUR_TEST_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_YOUR_TEST_WEBHOOK_SECRET"

TIEBREAKER_API_KEY="tiebreaker-local-dev-key"
REDIS_URL="redis://localhost:6379/0"

BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Local MLflow file tracking (leave default unless you point at a server).
MLFLOW_TRACKING_URI="file:./mlruns"